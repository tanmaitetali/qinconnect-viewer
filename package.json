{
  "name": "qinconnect-log-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Static dashboard for viewing and analyzing Amazon Connect Q in Connect AI Agent logs from CloudWatch. Calls CloudWatch/Bedrock directly from the browser with user-supplied AWS credentials; no backend.",
  "workspaces": [
    "frontend",
    "cdk/frontend"
  ],
  "scripts": {
    "frontend:dev": "npm --workspace frontend run dev",
    "frontend:build": "npm --workspace frontend run build",
    "cdk-frontend:synth": "npm --workspace @qinconnect-log-viewer/cdk-frontend exec -- cdk synth",
    "cdk-frontend:diff": "npm --workspace @qinconnect-log-viewer/cdk-frontend exec -- cdk diff",
    "cdk-frontend:deploy": "npm --workspace @qinconnect-log-viewer/cdk-frontend exec -- cdk deploy --all",
    "cdk-frontend:destroy": "npm --workspace @qinconnect-log-viewer/cdk-frontend exec -- cdk destroy --all"
  }
}
