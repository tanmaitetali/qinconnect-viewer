# AWS Configuration
# Option 1: Use a named AWS profile (from ~/.aws/credentials)
AWS_PROFILE=default

# Option 2: Use explicit access keys (overrides profile)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS Region (required)
AWS_REGION=us-east-1

# CloudWatch Log Group (optional — can also be configured in the UI)
# LOG_GROUP_NAME=/aws/connect/ai-agents/your-instance
