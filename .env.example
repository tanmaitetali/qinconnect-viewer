# AWS Configuration
# Profile name from ~/.aws/credentials (e.g., "default", "cx-qa", "prod")
AWS_PROFILE=cx-qa

# AWS Region where your Connect instance lives
AWS_REGION=us-east-1

# CloudWatch Log Group for Q in Connect AI Agent logs
# Format: /aws/connect/ai-agents/<assistant-name>
LOG_GROUP_NAME=/aws/connect/ai-agents/ss-cc-qa-main-menu

# Bedrock AI Analysis (for "Get AI Analysis" feature)
# Profile for Bedrock access (defaults to AWS_PROFILE if not set)
AWS_BEDROCK_PROFILE=default
# Region where Bedrock models are available (defaults to AWS_REGION)
AWS_BEDROCK_REGION=us-east-1
# Model ID for analysis (defaults to Claude Sonnet)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Alternative: explicit access keys (takes priority over profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
